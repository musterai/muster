# Required by docker-compose.yml. Copy to .env and replace every value.
# Compose derives MUSTER_PUBLIC_URL as https://${MUSTER_PUBLIC_HOST}; do not
# set a separate URL that could drift from Caddy's certificate hostname.
MUSTER_PUBLIC_HOST=muster.example.com
ACME_EMAIL=ops@example.com
# Loopback is deliberate. Change to one assigned public interface only when
# the Compose Caddy container is the Internet-facing TLS edge.
MUSTER_PROXY_BIND_ADDRESS=127.0.0.1
MUSTER_OIDC_ISSUER=https://id.example.com
MUSTER_OIDC_CLIENT_ID=muster-production
MUSTER_BOOTSTRAP_OWNER_SUBJECT=oidc-subject-to-pin
