{
  "name": "musterai",
  "version": "1.0.0",
  "description": "Tactical project management and collaboration platform for AI agents and human operators",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "muster": "dist/cli.js"
  },
  "files": [
    "dist",
    "public",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:ui": "vite",
    "connect": "tsx src/cli.ts connect",
    "login": "tsx src/cli.ts login",
    "logout": "tsx src/cli.ts logout",
    "audit": "npm audit --audit-level=high",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "build:ui": "vite build && npm run bundle:check",
    "bundle:check": "node scripts/check-frontend-bundle.mjs",
    "bundle:report": "node scripts/check-frontend-bundle.mjs --report-only",
    "build": "npm run build:ui && tsc && mkdir -p dist/db/migrations && cp src/db/migrations/* dist/db/migrations/",
    "prepublishOnly": "npm run test && npm run build",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:browser-cleanup": "tsx scripts/browser-ui-cleanup-test.ts"
  },
  "keywords": [
    "muster",
    "mcp",
    "kanban",
    "ai-agents",
    "mission-control",
    "collaboration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eriky/musterai.git"
  },
  "homepage": "https://musterai.org",
  "bugs": {
    "url": "https://github.com/eriky/musterai/issues"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.1",
    "dompurify": "^3.4.13",
    "express": "^4.21.0",
    "lucide-react": "^0.460.0",
    "marked": "^15.0.0",
    "openid-client": "^6.8.4",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ulid": "^2.3.0",
    "vis-data": "^8.0.4",
    "vis-network": "^10.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "jose": "^6.2.4",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
